rules_version = '2';

// The whole authorization model (spec §3, §7.1): a signed-in user may read and
// write everything under a household they are a member of, and nothing else.
// Membership is the household document's `memberUids` — no custom claim, so a
// future backend can answer the same question with one read (spec §7.4).
//
// Stage 3 adds two things on top:
//   - Joining. A member writes `/invites/{email}` naming the household; when that
//     Google account signs in, the rules let it append its own uid to `memberUids`
//     because `request.auth.token.email` matches the invite. No backend needed.
//   - The beta gate. Founding a household needs `/founders/{email}` to exist — a
//     document only ever written by hand in the console (or by scripts/seed.ts in
//     the emulator). Everyone else who signs in has to be invited. To open the app
//     up later, drop `isFounder()` from the household `create` rule.
//
// Deploy with `firebase deploy --only firestore:rules`; tested by `pnpm test:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Google tokens always carry a verified email, but a missing map key is an
    // evaluation *error* in rules, not null, and an error poisons any `||` it sits
    // in — so guard the key before reading it.
    function hasVerifiedEmail() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email_verified == true;
    }

    // Invites and founders are keyed by lower-cased email.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.memberUids;
    }

    function isFounder() {
      return hasVerifiedEmail()
        && exists(/databases/$(database)/documents/founders/$(myEmail()));
    }

    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }

    function hasInviteFor(hid) {
      return exists(invitePath(myEmail()))
        && get(invitePath(myEmail())).data.householdId == hid;
    }

    // `members.{uid}` is a display profile and nothing more.
    function validProfile(profile) {
      return profile is map
        && profile.keys().hasOnly(['name', 'email'])
        && profile.name is string
        && profile.email is string;
    }

    // Stage 2 households have no `members` map; default it so diff() can't error.
    function membersChanged() {
      return request.resource.data.get('members', {}).diff(resource.data.get('members', {})).affectedKeys();
    }

    match /households/{hid} {
      // `list` is satisfied by the store's `memberUids array-contains uid` query and
      // nothing broader — rules are evaluated against the query, not the results.
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberUids;

      // Beta: only a founder may create, and only a household of exactly themselves.
      allow create: if isFounder()
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.members is map
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members.keys().hasAll([request.auth.uid])
        && validProfile(request.resource.data.members[request.auth.uid]);

      // Two ways to update:
      //  (i) A member edits the name, the settings and their own profile. Membership
      //      is untouchable here — no removing yourself, no removing anyone else.
      // (ii) A non-member joins: exactly their own uid appended to memberUids, exactly
      //      their own profile added, nothing else touched, and a pending invite for
      //      their email that names this household. Inside the join batch get() and
      //      exists() see the pre-batch state, so deleting the invite in the same
      //      batch is fine.
      allow update: if
        (
          isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'settings', 'members'])
          && membersChanged().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.get('members', {}))
              || validProfile(request.resource.data.members[request.auth.uid]))
        ) || (
          hasVerifiedEmail()
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'members'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && membersChanged().hasOnly([request.auth.uid])
          && membersChanged().hasAll([request.auth.uid])
          && validProfile(request.resource.data.members[request.auth.uid])
          && hasInviteFor(hid)
        );

      allow delete: if false;

      // The ingredient catalog (spec §3): exactly `{ name, nameLower }`, with
      // `nameLower` derived from `name` so the client's uniqueness check and
      // autocomplete can trust it. Uniqueness itself can't be enforced here — rules
      // can't query — so it's the client's job against the in-memory catalog.
      match /ingredients/{ingredientId} {
        function validIngredient(d) {
          return d.keys().hasOnly(['name', 'nameLower'])
            && d.keys().hasAll(['name', 'nameLower'])
            && d.name is string
            && d.name.size() > 0
            && d.name.size() <= 100
            && d.name == d.name.trim()
            && d.nameLower == d.name.lower();
        }

        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid) && validIngredient(request.resource.data);
      }

      // meals, weekPlans: one extra document read per evaluation for the membership
      // lookup, accepted at household scale (spec §3).
      // `{collection}` is a single-segment wildcard on purpose: in rules v2 a bare
      // `{document=**}` here also matches zero segments — the household doc itself —
      // and would let a member delete it or drop their own membership.
      // Overlapping matches are OR'd, so `ingredients` is excluded explicitly or this
      // block would wave through the malformed docs the one above rejects.
      match /{collection}/{document=**} {
        allow read, write: if isMember(hid) && collection != 'ingredients';
      }
    }

    // One pending invite per address. The doc id is the lower-cased email so the
    // invitee can fetch it from their own token without knowing the household.
    match /invites/{emailLower} {
      function isInvitee() {
        return hasVerifiedEmail() && myEmail() == emailLower;
      }

      allow get: if isInvitee();

      // Only satisfiable by `where('householdId', '==', hid)` from a member of that
      // household — an unfiltered list can't pin householdId and is denied.
      allow list: if signedIn() && isMember(resource.data.householdId);

      allow create: if signedIn()
        && isMember(request.resource.data.householdId)
        && request.resource.data.keys().hasOnly(['email', 'householdId', 'householdName', 'invitedBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['email', 'householdId', 'householdName', 'invitedBy', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailLower
        && request.resource.data.householdName is string
        && request.resource.data.invitedBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      // Re-issuing is delete + create. A plain overwrite would let another household
      // hijack an invite this address already holds.
      allow update: if false;

      allow delete: if isInvitee() || (signedIn() && isMember(resource.data.householdId));
    }

    // Written by hand in the console (or by scripts/seed.ts locally). The rules
    // engine reads it through exists(), which bypasses this — clients never can.
    match /founders/{emailLower} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
